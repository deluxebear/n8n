{
	"extends": ["@n8n/typescript-config/tsconfig.common.go.json"],
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"types": ["vite/client", "vitest/globals"],
		"isolatedModules": true,
		// Use ESLint bundled types for config helpers and plugins.
		"paths": {
			"eslint": ["./node_modules/eslint/lib/types/index.d.ts"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/template/templates/**/template", "src/template/templates/shared"]
}
